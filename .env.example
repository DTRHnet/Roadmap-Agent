# ROADMAP-AGENT runtime overrides
# Copy to ".env" in your project root and adjust as needed.

# LLM provider selection: ollama | openllama | claude
RMA_LLM_PROVIDER=ollama

# Ollama settings (works with local/remote host; useful for WSL path split)
RMA_OLLAMA_HOST=http://127.0.0.1:11434
# Default Ollama model used for analyze-init generation
RMA_OLLAMA_MODEL=llama3.1:latest

# Require local Ollama for analyze-init generation:
# 1 = fail if Ollama/model unavailable, 0 = allow heuristic fallback
RMA_REQUIRE_OLLAMA=0

# OpenAI-compatible local hosting (openllama provider)
RMA_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
RMA_OPENAI_MODEL=openllama
RMA_OPENAI_API_KEY=local-no-key

# Claude provider (requires ANTHROPIC_API_KEY to be set)
RMA_CLAUDE_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_API_KEY=paste_secret_here

# Optional: force fallback text menus (disable fzf usage)
RMA_DISABLE_FZF=0

# Optional: Python virtual environment path used by setup-local-models scripts
# Relative paths are resolved from project root.
RMA_PYTHON_VENV_DIR=.rma/venv

# MemPalace: real CLI + Python packages required for plan/mine (no simulated data).
# 1 = doctor/runtime warnings treat missing mempalace/chromadb as errors
RMA_REQUIRE_MEMPALACE=1
# Optional absolute path to mempalace executable if not on PATH
# RMA_MEMPALACE_BIN=
# 1 = allow generic markdown template if mempalace plan fails (dev-only)
RMA_ALLOW_PLAN_FALLBACK=0
