# =============================================================================
# ROADMAP-AGENT — example environment (copy to ".env" in your project root)
# =============================================================================
#
# WHITELIST: Only variable names matched by load_rma_env_file() in
# scripts/unix/roadmap-agent.sh are READ from this file into the shell when
#   you run roadmap-agent / rma. Those same keys are editable in the Web UI
#   (web/backend/app/constants.py must stay in sync).
#
# Any other KEY=value lines you add are IGNORED by load_rma_env_file but remain
# in the file for other tools — or merge when you save from the Web UI (unknown
# lines are preserved).
#
# Defaults: If .env is missing entirely, load_rma_env_file() still applies
# built-in defaults for RMA_* (see script). If .env exists, only listed keys
# override; missing keys still get script defaults after the file is read.
#
# Never commit real secrets. .env should be in .gitignore.
#
# =============================================================================
# A) Runtime roots — NOT in the whitelist (set by launchers / IDE / CI)
# =============================================================================
#
# ROADMAP_AGENT_PROJECT_ROOT
#   Absolute path to the repo you are driving (contains .rma/). Launchers and
#   RUN.* set this to cwd. Required for split layouts (toolkit ≠ project).
#
# ROADMAP_AGENT_APP_ROOT
#   Path to the ROADMAP-AGENT checkout (scripts/, rma_mcp/, VERSION). RUN.*
#   and persistence set this. Override only for exotic layouts.
#
# =============================================================================
# B) Terminal / UX — optional; most are NOT in the whitelist
# =============================================================================
#
# NO_COLOR=1
#   If set to any non-empty value, roadmap-agent avoids ANSI colors (handy in CI).
#   Not read from .env by load_rma_env_file — export in the shell or use globally.
#
# PIP_DEFAULT_TIMEOUT=120
#   Seconds for pip HTTP reads during bootstrap (RUN.*, setup-venv, web-api).
#   Not in whitelist — export before running installers if you need a different value.
#

# =============================================================================
# C) LLM provider — plan, analyze-init, agent / run-agent
# =============================================================================
#
# RMA_LLM_PROVIDER — required logical choice:
#   ollama     — Local Ollama (binary on PATH and/or HTTP at RMA_OLLAMA_HOST).
#                Agent uses JSON/native APIs when available.
#   openllama  — Any OpenAI-compatible POST …/v1/chat/completions endpoint
#                (LM Studio, vLLM, OpenAI, etc.). Uses RMA_OPENAI_* below.
#   claude     — Anthropic Messages API; requires ANTHROPIC_API_KEY + Python.
#
RMA_LLM_PROVIDER=ollama

# --- When RMA_LLM_PROVIDER=ollama ------------------------------------------------
# RMA_OLLAMA_HOST
#   REST base URL, NO trailing path (default http://127.0.0.1:11434).
#   WSL: Ollama on Windows is often still 127.0.0.1:11434 from WSL2.
RMA_OLLAMA_HOST=http://127.0.0.1:11434

# RMA_OLLAMA_MODEL
#   Model tag as in `ollama list` (must exist locally or pull first).
RMA_OLLAMA_MODEL=llama3.1:latest

# RMA_REQUIRE_OLLAMA
#   0 = allow heuristic fallback where implemented (default).
#   1 = hard-fail analyze-init / some paths if Ollama or model unreachable.
RMA_REQUIRE_OLLAMA=0

# --- When RMA_LLM_PROVIDER=openllama --------------------------------------------
# RMA_OPENAI_BASE_URL
#   OpenAI-compatible API root, usually ending in /v1 for many local servers.
RMA_OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# RMA_OPENAI_MODEL
#   Model id string sent in API requests.
RMA_OPENAI_MODEL=openllama

# RMA_OPENAI_API_KEY
#   API key or placeholder (e.g. local-no-key for LM Studio). Roadmap code uses
#   this variable first; OPENAI_API_KEY is a second name some SDKs expect.
RMA_OPENAI_API_KEY=local-no-key

# OPENAI_API_KEY
#   Optional duplicate for tools that only read this name. Same secrecy as above.
# OPENAI_API_KEY=

# --- When RMA_LLM_PROVIDER=claude -----------------------------------------------
# RMA_CLAUDE_MODEL
#   Anthropic model id (see Anthropic docs for current ids).
RMA_CLAUDE_MODEL=claude-3-5-sonnet-latest

# ANTHROPIC_API_KEY
#   Required for claude provider. Never commit.
# ANTHROPIC_API_KEY=

# =============================================================================
# D) Python virtualenv & MemPalace
# =============================================================================
#
# RMA_PYTHON_VENV_DIR
#   Directory for project venv (default .rma/venv). Relative paths resolve from
#   ROADMAP_AGENT_PROJECT_ROOT. Windows paths may be rewritten under WSL.
RMA_PYTHON_VENV_DIR=.rma/venv

# RMA_REQUIRE_MEMPALACE
#   1 = doctor / warnings treat missing mempalace imports or CLI as problems (default).
#   0 = softer checks for LLM-only workflows without mining.
RMA_REQUIRE_MEMPALACE=1

# RMA_MEMPALACE_BIN
#   Optional absolute path to mempalace executable if not on PATH.
# RMA_MEMPALACE_BIN=

# RMA_MEMPALACE_MINE_DIR
#   Directory passed to: mempalace mine <dir> from hub menus. "." or empty =
#   project root. Relative → under project root.
# RMA_MEMPALACE_MINE_DIR=.

# =============================================================================
# E) Plan behavior
# =============================================================================
#
# RMA_ALLOW_PLAN_FALLBACK
#   0 = if LLM plan fails, surface error (default).
#   1 = write a static markdown scaffold to plan.md (dev/CI escape hatch; logged).
RMA_ALLOW_PLAN_FALLBACK=0

# RMA_PLAN_INTERACTIVE
#   1 = on a TTY, prompt for open questions from .rma/open-questions.md and
#       lines containing "Open:" in .rma/description|ui|stack|other.md; answers
#       append to .rma/other.md before the LLM runs.
#   0 = non-interactive (same as: roadmap-agent plan --no-interactive).
RMA_PLAN_INTERACTIVE=1

# RMA_PLAN_INTERACTIVE_MAX
#   Maximum open-question prompts per plan run (default 15 if unset).
# RMA_PLAN_INTERACTIVE_MAX=15

# RMA_DISABLE_FZF
#   0 = use fzf when available (default).
#   1 = always use plain text menus and selectors.
# RMA_DISABLE_FZF=0

# =============================================================================
# F) Companion Web UI stack (hub: web-api / web-frontend)
# =============================================================================
# Loaded by load_rma_env_file for CLI/hub when starting the web stack. The
# running FastAPI process ALSO reads RMA_WEB_* from its environment — see
# web/run-backend.* and web/backend/app/settings.py (host, port, admin_token,
# app_root, cors_origins map to RMA_WEB_HOST, RMA_WEB_PORT, RMA_WEB_ADMIN_TOKEN,
# RMA_WEB_APP_ROOT, RMA_WEB_CORS_ORIGINS). Optional defaults: web/rma-web.yaml
# (copy from web/rma-web.config.example.yaml).
#
# RMA_WEB_HOST=127.0.0.1
#   Bind address the CLI uses when starting uvicorn from hub (default 127.0.0.1).

# RMA_WEB_PORT=8765
#   FastAPI listen port (default 8765).

# RMA_WEB_VITE_PORT=5173
#   Vite dev server port passed from hub to npm run dev (default 5173).

# RMA_WEB_FREE_PORT_ASK=1
#   1 = if API or Vite port is busy, prompt (y/N) before trying to free it.
#   0 = fail immediately on busy port.

# RMA_WEB_VITE_PROXY_TARGET=http://127.0.0.1:8765
#   Full URL of the API as seen by the browser; Vite proxies /api here.

# --- Web API process only (often set in shell or Docker, not always in .env) ---
# RMA_WEB_ADMIN_TOKEN=
#   If set, mutating FastAPI routes require HTTP header X-RMA-Web-Token with
#   this exact value. Not in load_rma_env_file whitelist — export for uvicorn.
#
# RMA_WEB_APP_ROOT=
#   Toolkit root for the API’s rma runner (defaults next to web/backend).
#
# RMA_WEB_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
#   Comma-separated allowed browser origins for CORS.

# =============================================================================
# G) MCP server (hub Web & MCP / rma mcp-start / python -m rma_mcp)
# =============================================================================
# See docs/MCP-SERVER.md and rma_mcp/client-config.example.json.
#
# RMA_MCP_TRANSPORT
#   streamable-http — default when unset in load_rma_env_file; HTTP MCP; pair
#                     with RMA_MCP_DETACH=1 to release the terminal from mcp-start.
#   sse             — alternate HTTP-style transport (SDK-dependent).
#   stdio           — JSON-RPC on stdout only; use for Cursor/Claude command MCP;
#                     set RMA_MCP_DETACH=0; do not print non-JSON to stdout.
# RMA_MCP_TRANSPORT=streamable-http

# RMA_MCP_HOST=127.0.0.1
#   Bind address for streamable-http / sse (default 127.0.0.1).

# RMA_MCP_PORT=8767
#   TCP port for HTTP MCP (default 8767).

# RMA_MCP_NAME=roadmap-agent
#   Server display name for MCP hosts.

# RMA_MCP_MAX_STEPS=50
#   Hint passed to clients; not enforced by the server.

# RMA_MCP_ALLOW_SHELL=0
#   0 = disable run_shell tool (default, safest).
#   1 = allow arbitrary shell from MCP (trusted projects only).

# RMA_MCP_PROJECT_ROOT=.
#   Optional path relative to project root, or absolute, overriding only the MCP
#   process project root (see cmd_mcp_start).

# RMA_MCP_LOG=1
#   1 = append JSON lines to .rma/mcp/logs/toolcalls.jsonl
#   0 = disable tool logging

# RMA_MCP_DETACH=1
#   1 = default: mcp-start runs HTTP MCP in background (nohup, .rma/mcp/nohup.log).
#   0 = keep server in foreground for HTTP (or use: mcp-start --foreground).
#   Ignored for stdio.

# RMA_MCP_FORCE=0
#   1 = before starting HTTP MCP, kill PID stored in .rma/mcp/runtime.json
#       (best-effort), same as mcp-start --force.

# Runtime artifact (not an env var): .rma/mcp/runtime.json written by HTTP/sse
# server with pid, host, port, transport for status lines and doctor.

# =============================================================================
# H) Optional integrations
# =============================================================================
#
# GITHUB_TOKEN
#   Optional token for authenticated GitHub API calls from tooling.
# GITHUB_TOKEN=

# =============================================================================
# I) Other variables used elsewhere (not in load_rma_env_file whitelist)
# =============================================================================
#
# RMA_WINDOWS_BRIDGE=1
#   Set automatically by scripts/windows/roadmap-agent.ps1 when delegating to bash.
#
# RMA_PYTHON_BIN
#   Set by configure_python_runtime to the chosen interpreter — do not put in .env.
#
# RMA_RELEASE_IMAGE_NAME  (default roadmap-agent)
# RMA_RELEASE_REPO_ROOT   (optional; release-rma.sh from a temp LF-normalized tree)
#
# VITE_DOCS_BASE
#   Frontend build-time base URL for documentation links in the SPA (see web/README.md).
#
# SYSINFO_WORKSPACE_ROOT
#   Override workspace root for sysinfo/sysinfo.py (otherwise auto-detect).
#
# AGENT_* / custom keys
#   Not loaded by roadmap-agent.sh; safe to keep for your own tooling if needed.
