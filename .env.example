# ROADMAP-AGENT runtime overrides
# Copy to ".env" in your project root and adjust as needed.

# Default local LLM model used for analyze-init generation
RMA_OLLAMA_MODEL=llama3.1:latest

# Require local Ollama for analyze-init generation:
# 1 = fail if Ollama/model unavailable, 0 = allow heuristic fallback
RMA_REQUIRE_OLLAMA=0

# Optional: force fallback text menus (disable fzf usage)
RMA_DISABLE_FZF=0
