# =============================================================================
# ROADMAP-AGENT — example environment (copy to ".env" in your project root)
# =============================================================================
# Only keys matched by load_rma_env_file() in scripts/unix/roadmap-agent.sh are
# applied; other lines are ignored. Never commit real secrets (.env belongs in
# .gitignore).
#
# --- Runtime roots (usually set by launchers, not .env) --------------------
# ROADMAP_AGENT_PROJECT_ROOT
#   Absolute path to the repository you are driving. When you use a global
#   install (persistence), the shell sets this to your cwd so .rma/ and
#   roadmaps stay in YOUR tree instead of under the install directory.
#
# ROADMAP_AGENT_APP_ROOT
#   Where the ROADMAP-AGENT app files live (scripts/, VERSION, docs/). Defaults
#   to the project root; override only if you split “tool install” from “repo”.
#
# --- Terminal / UX ----------------------------------------------------------
# NO_COLOR=1
#   If set, disables ANSI colors in roadmap-agent output (common in CI logs).
#
# RMA_DISABLE_FZF=1
#   Force plain text menus instead of fzf (useful without fzf installed or over SSH).

# =============================================================================
# LLM provider (plan, analyze-init, agent / run-agent, proposed .rma files)
# =============================================================================
# RMA_LLM_PROVIDER — which backend speaks to the model:
#   ollama     — local Ollama (CLI or HTTP at RMA_OLLAMA_HOST). JSON agent mode
#                uses native JSON when possible (--format json / API format).
#   openllama  — any OpenAI-compatible /v1/chat/completions endpoint (LM Studio,
#                vLLM, remote OpenAI, etc.). Uses RMA_OPENAI_* variables below.
#   claude     — Anthropic Messages API; requires ANTHROPIC_API_KEY and Python.
#
# If agent mode previously “only worked with Ollama”, set your provider here;
# agent now follows the same RMA_LLM_PROVIDER as plan.
RMA_LLM_PROVIDER=ollama

# --- Ollama (RMA_LLM_PROVIDER=ollama) ---------------------------------------
# RMA_OLLAMA_HOST — REST API base, no trailing path (default local install).
#   WSL tip: Ollama on Windows is often reachable at http://127.0.0.1:11434 from
#   WSL2; if not, try the host gateway or run Ollama inside WSL.
RMA_OLLAMA_HOST=http://127.0.0.1:11434

# RMA_OLLAMA_MODEL — tag must exist locally (ollama pull …) or plan/agent fail.
RMA_OLLAMA_MODEL=llama3.1:latest

# RMA_REQUIRE_OLLAMA — for analyze-init / some generation paths:
#   1 = hard-fail if Ollama or the model is unreachable
#   0 = allow heuristic fallback where implemented (default)
RMA_REQUIRE_OLLAMA=0

# --- OpenAI-compatible API (RMA_LLM_PROVIDER=openllama) ----------------------
# Name is historical (“openllama”); works with any HTTP server that exposes
# POST {base}/v1/chat/completions in OpenAI-compatible shape.
RMA_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
RMA_OPENAI_MODEL=openllama
RMA_OPENAI_API_KEY=local-no-key

# OPENAI_API_KEY — optional; exported from .env for other tools / SDKs that
# expect this name. Roadmap plan/agent HTTP code uses RMA_OPENAI_API_KEY first.
# OPENAI_API_KEY=

# --- Anthropic Claude (RMA_LLM_PROVIDER=claude) -------------------------------
RMA_CLAUDE_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_API_KEY — required for claude provider (keep secret).
# ANTHROPIC_API_KEY=

# =============================================================================
# Python / MemPalace
# =============================================================================
# RMA_PYTHON_VENV_DIR — venv used by setup-local-models and doctor hints.
#   Relative paths resolve from project root (after ROADMAP_AGENT_PROJECT_ROOT).
RMA_PYTHON_VENV_DIR=.rma/venv

# RMA_REQUIRE_MEMPALACE — strict checks in doctor / warnings panel:
#   1 = warn or fail checks if mempalace Python imports or CLI look missing
#   0 = softer diagnostics (e.g. LLM-only workflows without mining)
RMA_REQUIRE_MEMPALACE=1

# RMA_MEMPALACE_BIN — optional full path to mempalace executable if not on PATH
#   (e.g. only installed inside the project venv).
# RMA_MEMPALACE_BIN=

# RMA_MEMPALACE_MINE_DIR — directory passed to: mempalace mine <dir>
#   Default empty = project root. Relative paths are under project root.
# RMA_MEMPALACE_MINE_DIR=.

# =============================================================================
# Plan behavior
# =============================================================================
# RMA_ALLOW_PLAN_FALLBACK — when LLM plan generation fails:
#   1 = write a static markdown scaffold to plan.md (logged; dev/CI escape hatch)
#   0 = fail with a message to fix LLM / MemPalace context (default)
RMA_ALLOW_PLAN_FALLBACK=0

# RMA_PLAN_INTERACTIVE — before plan, on a TTY, prompt for “open questions”
#   collected from .rma/open-questions.md (- bullets) and lines containing
#   Open: in .rma/description|ui|stack|other.md. Answers append to .rma/other.md.
#   0 = skip prompts (CI, scripts); same effect as: roadmap-agent plan --no-interactive
RMA_PLAN_INTERACTIVE=1

# RMA_PLAN_INTERACTIVE_MAX — cap prompts per plan run (default 15 if unset).
# RMA_PLAN_INTERACTIVE_MAX=15

# =============================================================================
# Optional companion web UI (hub: Web & MCP + uvicorn)
# =============================================================================
# These keys ARE loaded from this file by load_rma_env_file() for web-api /
# web-frontend (ports, proxy, free-port prompt). The FastAPI process also reads
# RMA_WEB_* from its environment (see web/run-backend.*). Optional toolkit defaults:
#   web/rma-web.yaml  (copy from web/rma-web.config.example.yaml)
#
# RMA_WEB_HOST=127.0.0.1
# RMA_WEB_PORT=8765
# RMA_WEB_VITE_PORT=5173
# RMA_WEB_FREE_PORT_ASK=1
#   1 = prompt y/N to try fuser/lsof if API or Vite port is busy. 0 = fail fast.
# RMA_WEB_VITE_PROXY_TARGET=http://127.0.0.1:8765
#   Vite dev proxy target (must match host:port of the API if you change ports).
#
# Only for the uvicorn process (often set in shell, not always in .env):
# RMA_WEB_ADMIN_TOKEN=
#   If set, mutating API routes require header X-RMA-Web-Token with this value.
# RMA_WEB_APP_ROOT=
#   Toolkit checkout (scripts/). web/run-backend.ps1 / run-backend.sh set this.
# RMA_WEB_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# =============================================================================
# MCP server (hub Web & MCP / `rma mcp-start`) — Model Context Protocol for Cursor, Claude Desktop, …
# =============================================================================
# See docs/MCP-SERVER.md. Keys are loaded by load_rma_env_file().
#
# RMA_MCP_TRANSPORT=streamable-http
#   CLI default when unset: streamable-http (terminal released; see RMA_MCP_DETACH). Use stdio for
#   hosts that only support command-based MCP (Cursor/Claude config) — then stdout must be JSON-RPC only.
# RMA_MCP_TRANSPORT=stdio
#   Explicit stdio (pair with RMA_MCP_DETACH=0). Do not mix with banner text on stdout.
# RMA_MCP_NAME=roadmap-agent
#   Server display name.
# RMA_MCP_ALLOW_SHELL=0
#   1 = enable run_shell tool (arbitrary shell; use only on trusted projects).
# RMA_MCP_PROJECT_ROOT=.
#   Optional: managed repo path relative to ROADMAP_AGENT_PROJECT_ROOT, or absolute.
#   When set, overrides ROADMAP_AGENT_PROJECT_ROOT for the MCP process only (via cmd_mcp_start).
# RMA_MCP_MAX_STEPS=50
#   Hint for clients (not enforced by the server).
# RMA_MCP_LOG=1
#   1 = append JSON lines to .rma/mcp/logs/toolcalls.jsonl
# RMA_MCP_HOST=127.0.0.1
# RMA_MCP_PORT=8767
#   Used when RMA_MCP_TRANSPORT is streamable-http or sse.
# RMA_MCP_DETACH=1
#   CLI default when unset: 1 for HTTP transports (nohup; .rma/mcp/nohup.log). Ignored for stdio.
# RMA_MCP_DETACH=0
#   Block the shell on HTTP (mcp-start --foreground is equivalent when you pass it explicitly).
# RMA_MCP_FORCE=0
#   1 = stop prior MCP from .rma/mcp/runtime.json before bind (same as mcp-start --force).
# Runtime: when using HTTP transports, the server writes .rma/mcp/runtime.json (pid, host, port).

# =============================================================================
# Optional: other tools
# =============================================================================
# GITHUB_TOKEN — optional; exported for authenticated GitHub API / tooling.
# GITHUB_TOKEN=
