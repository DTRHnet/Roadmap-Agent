#!/usr/bin/env bash

set -u
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    if command -v pwsh >/dev/null 2>&1; then
      exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$SELF_DIR/roadmap-agent.ps1" "$@"
    fi
    exec powershell -NoProfile -ExecutionPolicy Bypass -File "$SELF_DIR/roadmap-agent.ps1" "$@"
    ;;
  *)
    exec bash "$SELF_DIR/roadmap-agent.sh" "$@"
    ;;
esac
