#!/usr/bin/env bash
# Portable launcher in launchers/ — repo root is parent of this directory.
set -u
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SELF_DIR/.." && pwd)"

case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    if command -v pwsh >/dev/null 2>&1; then
      exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$REPO_ROOT/scripts/windows/roadmap-agent.ps1" "$@"
    fi
    exec powershell -NoProfile -ExecutionPolicy Bypass -File "$REPO_ROOT/scripts/windows/roadmap-agent.ps1" "$@"
    ;;
  *)
    exec bash "$REPO_ROOT/scripts/unix/roadmap-agent.sh" "$@"
    ;;
esac
