# Optional companion web UI (FastAPI). Build from repository root only:
#   docker build -f docker/Dockerfile.web -t rma-web .
# (.dockerignore excludes .rma/venv so Windows Docker context upload does not fail on lib64 symlinks.)
FROM python:3.12-slim-bookworm
WORKDIR /workspace
COPY requirements-web.txt .
RUN pip install --no-cache-dir -r requirements-web.txt
COPY . .
ENV RMA_WEB_APP_ROOT=/workspace
WORKDIR /workspace/web/backend
EXPOSE 8765
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8765"]
