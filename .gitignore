# ROADMAP-AGENT safe .gitignore policy
# Keep tracked: source scripts, docs, templates (.env.example)
# Ignore: secrets, local runtime state, generated artifacts, caches

############################################
# Secrets and machine-local configuration
############################################
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
credentials.json
secrets*.json

############################################
# ROADMAP-AGENT local runtime state
############################################
.rma/
*.log
*.tmp
*.bak

############################################
# Python caches / virtual envs
############################################
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

############################################
# Node / JS caches
############################################
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

############################################
# Tooling / editor / OS noise
############################################
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

############################################
# Build and coverage outputs
############################################
dist/
build/
coverage/
*.coverage
*.lcov
